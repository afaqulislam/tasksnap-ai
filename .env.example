# TaskSnap AI environment configuration

# --- AI Provider: Groq (primary) ---
# Get your key at https://console.groq.com/keys
# Default vision model: qwen/qwen3.6-27b (reasoning is auto-disabled for qwen models).
GROQ_API_KEY=

# Optional: override the default model (defaults to qwen/qwen3.6-27b).
# Note: reasoning_effort=none is only applied to qwen models.
AI_MODEL=

# --- Alternative AI Provider (optional) ---
# Google Gemini vision model (used only if GROQ_API_KEY is not set):
# GOOGLE_GENERATIVE_AI_API_KEY=
# AI_MODEL=gemini-2.0-flash

# --- Development demo fallback ---
# Set to true only in local development to return sample results
# when no AI provider key is configured. Production default must be false.
DEMO_MODE=false
