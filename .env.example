# TaskSnap AI environment configuration

# --- AI Provider: Groq (primary) ---
# Get your key at https://console.groq.com/keys
# Default model: qwen/qwen3.8-27b (reasoning is auto-disabled for qwen models).
GROQ_API_KEY=

# Optional: override the Groq model.
# GROQ_MODEL=qwen/qwen3.8-27b

# --- Alternative AI Provider (optional) ---
# Google Gemini. Used automatically when GROQ_API_KEY is missing, when Groq
# errors out, or when Groq's quota is exhausted.
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Legacy: a single model override applied to *both* providers.
# Prefer GROQ_MODEL / GEMINI_MODEL — setting this while both keys exist will
# make Groq request a Gemini model (and fail).
# AI_MODEL=

# --- Development demo fallback ---
# Set to true to return sample results when no AI provider key is configured.
# With a key present, real analysis is used either way.
# NOTE: with no key and DEMO_MODE=false the API returns 503, not sample data.
DEMO_MODE=false

# --- Client-side OCR ---
# Screenshot text is extracted locally in the browser with Tesseract.js,
# so the AI only processes text (saves API tokens). Pick any Tesseract
# language codes here, comma-separated. Defaults to "eng".
# Examples: eng (English), urd (Urdu), ara (Arabic), spa (Spanish), deu (German).
NEXT_PUBLIC_OCR_LANGS=eng

# --- Notes ---
# Rate limiting: 10 requests per 10 minutes per IP (last x-forwarded-for hop),
# in-memory per serverless instance, resets on redeploy. Failed (5xx) requests
# are refunded.
# Uploads: PNG / JPEG / WEBP, up to 8 MB, auto-resized to 1024px before analysis.
# Request bodies are capped at 12 MB before parsing.
# The screenshot is only uploaded when OCR cannot read it — otherwise the
# extracted text is sent on its own.
