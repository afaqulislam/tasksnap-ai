# TaskSnap AI environment configuration

# --- AI Provider: Groq (primary) ---
# Get your key at https://console.groq.com/keys
# Default vision model: qwen/qwen3.8-27b (reasoning is auto-disabled for qwen models).
GROQ_API_KEY=

# Optional: override the default model (defaults to qwen/qwen3.8-27b).
# Note: reasoning_effort=none is only applied to qwen models.
AI_MODEL=

# --- Alternative AI Provider (optional) ---
# Google Gemini vision model. Used automatically when GROQ_API_KEY is missing
# or when Groq returns an error (e.g. rate limit / outage).
# GOOGLE_GENERATIVE_AI_API_KEY=
# AI_MODEL=gemini-2.0-flash

# --- Development demo fallback ---
# Set to true only in local development to return sample results
# when no AI provider key is configured. Production default must be false.
DEMO_MODE=false

# --- Client-side OCR ---
# Screenshot text is extracted locally in the browser with Tesseract.js,
# so the AI only processes text (saves API tokens). Pick any Tesseract
# language codes here, comma-separated. Defaults to "eng".
# Examples: eng (English), urd (Urdu), ara (Arabic), spa (Spanish), deu (German).
NEXT_PUBLIC_OCR_LANGS=eng

# --- Notes ---
# Rate limiting: 10 requests per 10 minutes per IP (in-memory, resets on redeploy).
# Uploads: PNG / JPEG / WEBP, up to 8 MB, auto-resized to 1024px before analysis.
# No API key + DEMO_MODE=true returns clearly labeled sample results.
